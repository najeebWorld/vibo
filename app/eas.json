{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_API_PORT": "8010" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_API_URL": "https://api.example.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_API_URL": "https://api.example.com" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./google-play-service-account.json" }
    }
  }
}
