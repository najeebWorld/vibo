# copy to .env; docker compose and the Makefile read it automatically.
# Phones on the LAN must reach API_BASE, e.g. http://192.168.1.20:8010
API_PORT=8000
API_BASE=http://localhost:8000
UPLOAD_SECRET=change-me
# host ports for psql / redis-cli from your machine (5432 and 6379 are often taken)
POSTGRES_PORT=55432
REDIS_PORT=56379
